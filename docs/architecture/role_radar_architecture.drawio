        <mxCell id="z2" value="The gate suite  -  every one of these can FAIL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
