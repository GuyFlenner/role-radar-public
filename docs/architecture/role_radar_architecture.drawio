        </mxCell>
        <mxCell id="c5" value="pytest (539)  -  behaviour" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="292" width="340" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="publish check  -  no personal data tracked" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="338" width="340" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="skill lint  -  prompt prose vs reality" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="384" width="340" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="rag goldens  -  retrieval quality" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="340" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="mypy  -  types" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="476" width="340" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c10" value="verify_all.sh
the local contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="170" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c11" value="pre-commit
pre-push hooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c12" value="ci.yml
GitHub Actions (Linux)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="490" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c13" value="Every gate reports exactly one of
PASS  /  FAIL  /  SKIPPED

SKIPPED is NOT a pass - it exits non-zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="1020" y="300" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="c14" value="gitleaks
full-history secret scan" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="510" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c15" value="Why all three points, always:
the RAG gate once existed in NONE of them
while verify_all.sh claimed to mirror CI." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="160" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c16" value="Vacuous-pass defences, each from a real escape:
- zero goldens -&gt; SKIPPED, exit 1
- goldens that assert nothing -&gt; FAIL
- CI fixture untracked -&gt; a git ls-files test
- partial facts -&gt; SKIPPED, never &#x27;clean&#x27;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="330" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c17" value="gitleaks ran `git log &lt;root&gt;^..HEAD`, scanned ZERO
bytes, and reported &#x27;no leaks found&#x27;.
Now a full-history scan - no range to get wrong." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
