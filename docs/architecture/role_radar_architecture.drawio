        <mxCell id="c1" value="Seven blocking gates, three enforcement points - a PASS has to mean something" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#6c8ebf;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1580" height="40" as="geometry"/>
